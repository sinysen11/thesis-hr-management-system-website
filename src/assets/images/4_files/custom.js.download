/*********** window scroll function starts ***********/
$(window).scroll(function () {  
  /*********** bluemenu goto section on homepage starts ***********/
  var cutoff = $(window).scrollTop();
  if ($('.bluemenu li a').length) {
  var sTop = $('.bluemenu li a').offset().top;
  $('.bluemenu li a').removeClass('active'); 
  if ($(window).scrollTop() == sTop) {    
    $('.bluemenu li a').each(function () {
      $(this).removeClass('active');
      if ($(this).is('a:not([href^="#"])')) {
        //
      } else {
        $(this).removeClass('active');
        var curHt = $(this).height();
        cutoff = cutoff - curHt;
        if ($($(this).attr('href')).offset().top + curHt > cutoff) {
          $('.bluemenu li a').removeClass('active');
          $(this).addClass('active');
          return false; // stops the iteration after the first one on screen
        }
      }
    });
  }
}
	/*********** bluemenu goto section on homepage ends ***********/

  var offset = ''; 
  if ($("div").hasClass('bludemenus')) {
    offset = $('.bludemenus').offset().top - 80;
  } else {
    $("body").addClass('nobluemenu');
  }
	var windscroll = $(window).scrollTop();
	if (windscroll >= offset) {
		$('body').addClass('fixed');
	} else {
		$('body').removeClass('fixed');
  }

	/*********** history function starts ***********/
	var cutoff = $(window).scrollTop() + 230; 
	var cutoffs = $(window).scrollTop() + $(window).height() - 300;
	$('.hislist li').each(function () {
		if ($(this).offset().top > cutoffs) {
			$('.hislist li').removeClass('current');
			$(this).addClass('current');
			return false; // stops the iteration after the first one on screen
		}
	});
	/*********** history function ends ***********/

	if ($(window).scrollTop() + $(window).height() > $(document).height() - 57) {
		$("body").addClass("footfix");
	} else {
		$("body").removeClass("footfix");
	}

	$('body').removeClass('arrofixed');
	var windscroll = $(window).scrollTop();
	if (windscroll >= 100) {
		$('body').addClass('arrofixed');
	} else {
		$('body').removeClass('arrofixed');
	}	

	$('body').addClass('arrofixedfade');
	setTimeout(function () {
		$('body').removeClass('arrofixedfade');
	}, 500);

});
/*********** window scroll function ends ***********/

