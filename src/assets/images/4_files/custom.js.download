  $(".aus").click(function (e) {
    e.preventDefault();
    if ($(this).prev().hasClass('slh')) {
      $(this).prev().removeClass('slh').slideDown();
      $(this).text("Read Less");
    } else {
      $(this).prev().addClass('slh').slideUp();
      $(this).text("Read More");
    }
  });
  $(".btn-read a,.btn-read button").click(function (e) {
    e.preventDefault();
    $(this).parent().parent().find('.ans').slideToggle();
    $(this).toggleClass('active');
    var text = $(this).text();
    if ($(this).hasClass('active')) {
      $(this).text(text.replace('More', 'Less'));
    } else {
      $(this).text(text.replace('Less', 'More'));
    }
  });
  $('.btn-request a').click(function () {
    var formText = $(this).parent().parent().find('.h1').text();
