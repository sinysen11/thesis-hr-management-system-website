if ($('#playvideo').data('vid')) {

  vPlayer = $('#video');
  vPlayerid = $('#playvideo').data('vid');
  vPlayer.YTplayer({
    width: '100%',
    height: 500,
    videoId: vPlayerid,
    playerVars: {
      'color': 'white',
      'showinfo': 0,
      'controls': 0,
      'modestbranding': 1,
      'autoplay': 0,
      'rel': 0
    },
    'onReady': function (event) {
      playerState = 1;
    },
    onStart: function () {
      playerState = 2;
    }, // on video start
    onPause: function () {
      playerState = 3;
    }, // on video pause
    onEnd: function () {
      playerState = 4;
    },
    'onStateChange': function (event) {
      if (event.data == 2) {

      }
      if (event.data == 1) {}
    }
  });
}
/*********** video api ends ***********/
