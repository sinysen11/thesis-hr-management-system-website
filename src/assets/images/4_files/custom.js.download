/*********** Ninja Form Validation ***********/
$(window).load(function() {
	$('.nf-field input[type=text]').each(function() {
	$(this).keyup(function(){
		var parent=$(this).closest('.nf-field-container');
		var grparent=parent.closest('.nf-form-content');
        if(this.value.length>0 && this.value.length<3){	
			parent.find('.nf-error-wrap').html('<div class="nf-error-msg nf-error-required-error">should be minimum 3 characters</div>');
            grparent.find('input[type=button]').prop("disabled",true);
            grparent.find('input[type=button]').closest('.nf-field').css('opacity', '0.3');
		}else{
			parent.find('.nf-error-wrap').html('');
			var x=0;
			var y=0;
			$('.nf-field input[type=text]').each(function() {
				x++;
				//console.log(this.value);
				if(this.value.length==0 || this.value.length>=3){
					y++;
				}				
        })
        grparent.hasClass('nf-error-required-error');
        if(x==y ){
            grparent.find('input[type=button]').prop("disabled",false);
			grparent.find('input[type=button]').closest('.nf-field').css('opacity', '1');
        }
		}
    });
});
//  var url_contact = window.location.href;
//   var urlc = new URL(url_contact);
