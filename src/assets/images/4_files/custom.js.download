	$('.bluemenu ul li a').click(function (e) {
    e.preventDefault();
    if ($(this).is('a:not([href^="#"])')) {
      var linkText = $(this).attr('href');
      window.location.href = linkText;
      window.location.assign = linkText;
    } else {
      var ctop = $($(this).attr('href')).offset().top - 45;
      $("html, body").animate({
        scrollTop: ctop
      }, "slow");
    }
    return false;
  }); 
